<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="21" android:translateY="21">
        <!-- Left face purple -->
        <path android:pathData="M 33 10 L 10 40 L 33 60 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:startX="10" android:startY="10" android:endX="33" android:endY="60" android:type="linear">
                    <item android:offset="0" android:color="#B388FF"/>
                    <item android:offset="1" android:color="#7C5CFF"/>
                </gradient>
            </aapt:attr>
        </path>
        
        <!-- Right face pink/blue -->
        <path android:pathData="M 33 10 L 56 40 L 33 60 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:startX="33" android:startY="10" android:endX="56" android:endY="60" android:type="linear">
                    <item android:offset="0" android:color="#FF80AB"/>
                    <item android:offset="1" android:color="#80D8FF"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Base -->
        <path android:pathData="M 10 40 L 33 60 L 56 40 L 33 52 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:startX="10" android:startY="40" android:endX="56" android:endY="60" android:type="linear">
                    <item android:offset="0" android:color="#4A148C"/>
                    <item android:offset="1" android:color="#0D47A1"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Light rays right -->
        <path android:pathData="M 45 32 L 64 22 L 64 28 Z" android:fillColor="#FF80AB" android:fillAlpha="0.8"/>
        <path android:pathData="M 50 40 L 64 36 L 64 42 Z" android:fillColor="#80D8FF" android:fillAlpha="0.8"/>
        <path android:pathData="M 45 48 L 64 54 L 64 60 Z" android:fillColor="#B388FF" android:fillAlpha="0.8"/>
        
        <!-- Incoming white ray -->
        <path android:pathData="M 4 33 L 18 28 L 18 32 Z" android:fillColor="#FFFFFF" android:fillAlpha="0.6"/>
    </group>
</vector>
